{
  "name": "manhunt",
  "version": "0.1.0",
  "private": true,
  "description": "Web-based GPS manhunt game",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "build:assets": "node scripts/build-asset-worker.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json && tsc -p client --noEmit",
    "vapid:keys": "node scripts/vapid-keys.ts",
    "release:cloudflare": "node scripts/cloudflare-release.ts",
    "test": "npm run test:server && npm run test:shared && npm run test:scripts && npm run test:worker && npm run test:client",
    "test:server": "vitest run --dir server --exclude \"**/*.workers.test.ts\"",
    "test:shared": "vitest run --dir shared",
    "test:scripts": "vitest run --dir scripts",
    "test:worker": "vitest run --config vitest.worker.config.ts --project worker --coverage --coverage.reportsDirectory=coverage/worker && vitest run --config vitest.worker.config.ts --project worker-serial --max-workers=1 --no-isolate --coverage --coverage.reportsDirectory=coverage/worker-serial",
    "test:client": "npm run test --workspace client",
    "test:e2e": "npm run test:e2e --workspace client",
    "test:docker": "node scripts/docker-e2e.ts",
    "test:release": "node scripts/release-e2e.ts",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:md",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"client/**/*.css\"",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:fix": "eslint . --fix && stylelint \"client/**/*.css\" --fix && markdownlint-cli2 --fix \"**/*.md\"",
    "prepare": "husky || true",
    "commitlint": "commitlint --edit"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.8",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-istanbul": "^4.1.11",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "husky": "^9.1.6",
    "jiti": "^2.7.0",
    "jsonc-parser": "^3.3.1",
    "markdownlint-cli2": "^0.23.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.131.1",
    "ws": "^8.21.1"
  }
}
