{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manhunt-spike-web-push-cpu",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "PUSH_ROOM", "class_name": "PushRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PushRoom"] }]
}
