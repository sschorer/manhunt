# Keep the build context small and the build reproducible: everything the image
# needs is either installed by `npm ci` or produced by the build itself.
.git
.github
.husky
node_modules
client/node_modules
dist
dist-next
dist-worker
dist-assets
client/dist
client/dev-dist
coverage
test-results
playwright-report
.wrangler
certs
.env
deploy/.env
*.log
