# Cache policy for the built PWA, read by both targets: Cloudflare's Workers
# Static Assets apply it directly, and on Docker the asset Worker applies it
# (server/assets/headers.ts). Vite copies this file into the build output, next
# to the assets it describes.
#
# Only content-hashed filenames are immutable. Everything else has a stable name,
# so a release would keep serving from cache unless it is revalidated — and a
# stale service worker would pin the whole app to the old build.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/workbox-*.js
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
