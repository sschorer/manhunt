{
  // Type-checking only for the Workers backend — the Worker entry, the `GameRoom`
  // Durable Object, the asset Worker the Docker target serves the PWA with, and
  // their tests — plus `shared/`. Built by Vite with @cloudflare/vite-plugin.
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "server/worker.ts",
    "server/worker-globals.d.ts",
    "server/seat.ts",
    "server/rules.ts",
    "server/assets/**/*.ts",
    "server/rooms/**/*.ts",
    "server/game/**/*.ts",
    "server/**/*.workers.test.ts",
    "shared/**/*.ts"
  ]
}
