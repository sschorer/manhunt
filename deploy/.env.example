# Settings for deploy/compose.yml. Copy to deploy/.env and edit.
#
#   cp deploy/.env.example deploy/.env      # or: make env

# Which proxy terminates TLS: `caddy` (a certificate for DOMAIN, ports 80+443)
# or `tunnel` (cloudflared dialling out, no published port, no Caddy).
COMPOSE_PROFILES=caddy

# The public hostname the PWA is served on. Caddy gets its certificate for this.
DOMAIN=manhunt.example.com

# The image to run. Pin TAG to a release for a reproducible deployment.
IMAGE=ghcr.io/sschorer/manhunt
TAG=latest

# Only for COMPOSE_PROFILES=tunnel: the token of a named Cloudflare Tunnel whose
# public hostname routes to http://app:8080.
TUNNEL_TOKEN=

# Only needed when the proxy in front rewrites the `Host` header. Caddy and
# cloudflared don't, so leave this empty.
PUBLIC_ORIGIN=

# Rule overrides, in seconds. Empty keeps the game's default (shown).
# How long a dropped player keeps their Seat; 0 releases it at once.
DISCONNECT_GRACE_S=
# How often a Ping reveal shows the Hiders (default 180).
PING_INTERVAL_S=
# How long a Game runs before the Hiders win on the clock (default 1800).
GAME_DURATION_S=

# Web Push. Generate a key pair with `npm run vapid:keys` (or leave these empty to
# keep push off). VAPID_SUBJECT is the contact the push services see for this
# deployment and must be a real mailto: or https: URI — without it, push stays off.
# These keys belong to this installation only: a Cloudflare deployment has its own.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
