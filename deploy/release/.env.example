# Settings for deploying this Manhunt release to Cloudflare. Copy to `.env` next
# to `deploy.sh` and fill it in:
#
#   cp .env.example .env
#
# `deploy.sh` reads this file as shell, so quote any value containing spaces. It
# never leaves your machine, and nothing in it is committed anywhere.

# The Cloudflare account the Worker is deployed to: 32 hex characters, shown as
# "Account ID" on the dashboard's Workers & Pages overview.
CLOUDFLARE_ACCOUNT_ID=

# The single hostname this deployment answers on, attached to the Worker as a
# Custom Domain. Its DNS must be managed by the same Cloudflare account, and the
# name must be free — a Custom Domain replaces any existing record for it.
MANHUNT_DOMAIN=

# Web Push contact for the browser push services: a real `mailto:` or `https:`
# URI they can reach you at. Leave it empty to keep push off.
#
# The keys themselves are secrets and never live in a config file. Generate a
# pair, then hand them to Cloudflare directly:
#
#   wrangler secret put VAPID_PUBLIC_KEY
#   wrangler secret put VAPID_PRIVATE_KEY
VAPID_SUBJECT=

# Rule overrides, in seconds. Empty keeps the game's default (shown).
# How long a dropped player keeps their Seat; 0 releases it at once.
DISCONNECT_GRACE_S=
# How often a Ping reveal shows the Hiders (default 180).
PING_INTERVAL_S=
# How long a Game runs before the Hiders win on the clock (default 1800).
GAME_DURATION_S=
