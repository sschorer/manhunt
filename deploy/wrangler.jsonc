{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "manhunt",
  "main": "../server/worker.ts",
  "compatibility_date": "2026-09-01",
  // Same-origin PWA served by Workers Static Assets; only these routes reach
  // the Worker. Keep in sync with the Workbox navigateFallbackDenylist.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*", "/health"]
  },
  // Rule overrides, in seconds (the defaults are shown). A blank or invalid value
  // falls back to the default.
  "vars": { "DISCONNECT_GRACE_S": "30", "PING_INTERVAL_S": "180", "GAME_DURATION_S": "1800" },
  "durable_objects": {
    "bindings": [{ "name": "GAMES", "class_name": "GameRoom" }]
  },
  // Nothing has been deployed yet. After the first release, only ever add
  // entries.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
