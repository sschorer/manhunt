{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "manhunt",
  "main": "../server/worker.ts",
  "compatibility_date": "2026-09-01",
  // Same-origin PWA served by Workers Static Assets; only these routes reach
  // the Worker. Keep in sync with the Workbox navigateFallbackDenylist.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*", "/health"]
  },
  // Rule overrides, in seconds (the defaults are shown). A blank or invalid value
  // falls back to the default.
  //
  // `VAPID_SUBJECT` is the operator's contact for the push services: a real
  // `mailto:` or `https:` URI, written here by the release deploy script. Blank
  // leaves Web Push off. The keys themselves are secrets, never vars:
  //   wrangler secret put VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY   (npm run vapid:keys)
  "vars": {
    "DISCONNECT_GRACE_S": "30",
    "PING_INTERVAL_S": "180",
    "GAME_DURATION_S": "1800",
    "VAPID_SUBJECT": ""
  },
  "durable_objects": {
    "bindings": [{ "name": "GAMES", "class_name": "GameRoom" }]
  },
  // Nothing has been deployed yet. After the first release, only ever add
  // entries.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
